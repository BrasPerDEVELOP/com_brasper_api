# PostgreSQL
POSTGRES_DB=com_brasper
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Aplicación
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=info
TIMEZONE=America/Lima
ROOT_PATH=
PUBLIC_URL=https://apibras.finzeler.com
API_PORT=8590
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
BRASPER_IA_SHARED_SECRET=

# Orígenes exactos; formato JSON requerido por pydantic-settings
CORS_ALLOWED_ORIGINS=["https://dashboard.brasper.com","https://brasper.com","https://www.brasper.com"]
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","172.20.0.0/16"]
REQUEST_ID_HEADER=X-Request-ID

# Límites por IP
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_PASSWORD_RESET=5
RATE_LIMIT_CONTACT_FORM=5

# JWT y sesión
AUTH_REQUIRED=true
AUTH_MODE=dual
JWT_SECRET_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=com.brasper.api
JWT_AUDIENCE=com.brasper.app
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=brasper_refresh_token
REFRESH_COOKIE_SECURE=true
# Necesario mientras dashboard.brasper.com y apibras.finzeler.com sean cross-site.
REFRESH_COOKIE_SAMESITE=none
REFRESH_COOKIE_DOMAIN=

# Compatibilidad temporal con tokens opacos
TOKEN_EXPIRATION_MINUTES=1440
TOKEN_REFRESH_EXPIRATION_MINUTES=2880

# Cloudflare R2
R2_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET_NAME=change-me
R2_PUBLIC_URL=
